				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Parse the JSON response",
									"const response = pm.response.json();",
									"",
									"// Save it as an environment variable",
									"pm.environment.set(\"jwt\", response.accessToken);",
									"pm.environment.set(\"jwt-refresh\", response.refreshToken);"
